<?xml version="1.0" encoding="utf-8"?>
<!--
    D06-L (FA 5.3): nav graph duy nhất của ứng dụng; điểm bắt đầu là KhoiDongFragment (SCR-CM-03).
    Mã điểm đến trùng tên lớp Fragment (camelCase), mã hành động theo action_{nguon}_to_{dich} (FC 3.3).
    Các màn hình mở chồng (SCR-SV-03 đến SCR-SV-12) và nav graph con soạn phiếu thêm ở các ngày sau.
    D07-L: hoSoMuonFragment (SCR-SV-14) nhận ba tham số chế độ. cheDoBiChan và hanhDongDaChon theo FA 5.3 (chế độ bị
    chặn từ SCR-SV-03, 04, 05); coNutQuayLai là cờ chế độ thứ ba do D07-L thêm để thanh tiêu đề hiện nút Quay lại khi mở
    từ Xem lý do hoặc từ ô Hồ sơ mượn ở Trang chủ (Wireframes ĐX-WF-14). Mở từ thanh điều hướng dưới thì giữ mặc định
    false nên không có nút Quay lại. Hai hành động của trangChuFragment mở chồng lên Trang chủ, không xóa ngăn xếp.
    D09-L: chiTietLoaiThietBiFragment (SCR-SV-03) mở chồng lên tra cứu, nhận maLoai và maPhong (chuỗi UUID). Hai hành động mới
    (từ tra cứu sang chi tiết; từ chi tiết sang hồ sơ ở chế độ bị chặn) không xóa ngăn xếp. Điểm đến có nhãn vì
    MainActivity lấy tiêu đề thanh ứng dụng từ nhãn; nút Quay lại tự có vì đây không phải tab gốc.
    D10-L: nav graph con soanPhieuGraph (FA 5.3 quy tắc 2) chứa soanPhieuYeuCauFragment (SCR-SV-04). Cả soanPhieuGraph và
    soanPhieuYeuCauFragment khai báo maPhong và maLoai tùy chọn để Safe Args sinh tham số cho action từ ngoài vào graph con
    và truyền xuống startDestination. soanPhieuGraph là phạm vi của SoanPhieuViewModel; SCR-SV-05 (D11-L) sẽ thêm vào cùng
    graph con. Từ SCR-SV-04 chỉ có hành động sang hồ sơ ở chế độ bị chặn (cổng quyền mượn của liên kết Đăng ký chờ).
    D10-L: hai hành động mở soanPhieuGraph (từ Trang chủ và từ chi tiết loại) không xóa ngăn xếp; SCR-SV-06/07 nối ở D12-L.
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/khoiDongFragment">

    <!-- FA 5.3 quy tắc 5: phiên kết thúc thì về đăng nhập và xóa toàn bộ ngăn xếp quay lại. -->
    <action
        android:id="@+id/action_global_to_dangNhapSinhVienFragment"
        app:destination="@id/dangNhapSinhVienFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/khoiDongFragment"
        android:name="com.nhom13.quanlymuontra.ui.khoidong.KhoiDongFragment"
        tools:layout="@layout/fragment_khoi_dong">
        <action
            android:id="@+id/action_khoiDongFragment_to_trangChuFragment"
            app:destination="@id/trangChuFragment"
            app:popUpTo="@id/khoiDongFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_khoiDongFragment_to_dangNhapSinhVienFragment"
            app:destination="@id/dangNhapSinhVienFragment"
            app:popUpTo="@id/khoiDongFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/dangNhapSinhVienFragment"
        android:name="com.nhom13.quanlymuontra.ui.dangnhap.DangNhapSinhVienFragment"
        tools:layout="@layout/fragment_dang_nhap_sinh_vien">
        <action
            android:id="@+id/action_dangNhapSinhVienFragment_to_trangChuFragment"
            app:destination="@id/trangChuFragment"
            app:popUpTo="@id/dangNhapSinhVienFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/trangChuFragment"
        android:name="com.nhom13.quanlymuontra.ui.trangchu.TrangChuFragment"
        android:label="@string/trang_chu_tieu_de"
        tools:layout="@layout/fragment_trang_chu">
        <action
            android:id="@+id/action_trangChuFragment_to_traCuuThietBiFragment"
            app:destination="@id/traCuuThietBiFragment" />
        <action
            android:id="@+id/action_trangChuFragment_to_hoSoMuonFragment"
            app:destination="@id/hoSoMuonFragment" />
        <action
            android:id="@+id/action_trangChuFragment_to_soanPhieuGraph"
            app:destination="@id/soanPhieuGraph" />
    </fragment>

    <fragment
        android:id="@+id/traCuuThietBiFragment"
        android:name="com.nhom13.quanlymuontra.ui.tracuu.TraCuuThietBiFragment"
        android:label="@string/tra_cuu_thiet_bi_tieu_de"
        tools:layout="@layout/fragment_tra_cuu_thiet_bi">
        <action
            android:id="@+id/action_traCuuThietBiFragment_to_chiTietLoaiThietBiFragment"
            app:destination="@id/chiTietLoaiThietBiFragment" />
    </fragment>

    <fragment
        android:id="@+id/chiTietLoaiThietBiFragment"
        android:name="com.nhom13.quanlymuontra.ui.tracuu.ChiTietLoaiThietBiFragment"
        android:label="@string/chi_tiet_thiet_bi_tieu_de"
        tools:layout="@layout/fragment_chi_tiet_loai_thiet_bi">
        <argument
            android:name="maLoai"
            app:argType="string" />
        <argument
            android:name="maPhong"
            app:argType="string" />
        <action
            android:id="@+id/action_chiTietLoaiThietBiFragment_to_hoSoMuonFragment"
            app:destination="@id/hoSoMuonFragment" />
        <action
            android:id="@+id/action_chiTietLoaiThietBiFragment_to_soanPhieuGraph"
            app:destination="@id/soanPhieuGraph" />
    </fragment>

    <fragment
        android:id="@+id/thongBaoFragment"
        android:name="com.nhom13.quanlymuontra.ui.thongbao.ThongBaoFragment"
        android:label="@string/thong_bao_tieu_de"
        tools:layout="@layout/fragment_thong_bao" />

    <fragment
        android:id="@+id/hoSoMuonFragment"
        android:name="com.nhom13.quanlymuontra.ui.hoso.HoSoMuonFragment"
        android:label="@string/ho_so_muon_tieu_de"
        tools:layout="@layout/fragment_ho_so_muon">
        <argument
            android:name="cheDoBiChan"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="hanhDongDaChon"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="coNutQuayLai"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <navigation
        android:id="@+id/soanPhieuGraph"
        app:startDestination="@id/soanPhieuYeuCauFragment">

        <argument
            android:name="maPhong"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="maLoai"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <fragment
            android:id="@+id/soanPhieuYeuCauFragment"
            android:name="com.nhom13.quanlymuontra.ui.phieuyeucau.SoanPhieuYeuCauFragment"
            android:label="@string/soan_phieu_tieu_de"
            tools:layout="@layout/fragment_soan_phieu_yeu_cau">
            <argument
                android:name="maPhong"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
            <argument
                android:name="maLoai"
                android:defaultValue="@null"
                app:argType="string"
                app:nullable="true" />
            <action
                android:id="@+id/action_soanPhieuYeuCauFragment_to_hoSoMuonFragment"
                app:destination="@id/hoSoMuonFragment" />
        </fragment>

    </navigation>

</navigation>
