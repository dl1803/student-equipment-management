<?xml version="1.0" encoding="utf-8"?>
<!--
    SCR-SV-05 Xem lại và gửi phiếu yêu cầu (UI-Screens 5.5, Wireframes SCR-SV-05, ĐX-WF-07): khối thông báo kết quả, thẻ
    tóm tắt phiếu (phòng, loại và số lượng, thời gian mượn) và hai nút Sửa, Gửi ghim ở cuối màn hình.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/ds_space_gutter">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.nhom13.quanlymuontra.common.widget.BannerView
                android:id="@+id/banner_ket_qua"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ds_space_section"
                android:visibility="gone" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_tom_tat"
                style="@style/Widget.Ds.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/xem_lai_tom_tat_tieu_de"
                        android:textAppearance="@style/TextAppearance.Ds.TitleCard" />

                    <com.nhom13.quanlymuontra.common.widget.KeyValueListView
                        android:id="@+id/kvl_tom_tat"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_3" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/ll_ghim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_color_surface_default"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_border_width_default"
            android:background="@color/ds_color_border_subtle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_4"
            android:layout_marginTop="@dimen/ds_space_3"
            android:layout_marginEnd="@dimen/ds_space_4"
            android:layout_marginBottom="@dimen/ds_space_3"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sua"
                style="@style/Widget.Ds.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_2"
                android:layout_weight="1"
                android:text="@string/xem_lai_nut_sua" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gui"
                style="@style/Widget.Ds.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_2"
                android:layout_weight="1"
                android:text="@string/xem_lai_nut_gui" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
