        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/ds_space_gutter"
        android:paddingTop="@dimen/ds_space_gutter"
        android:paddingEnd="@dimen/ds_space_gutter"
        android:paddingBottom="@dimen/ds_space_gutter" />

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
