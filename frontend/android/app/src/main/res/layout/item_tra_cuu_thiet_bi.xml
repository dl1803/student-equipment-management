<?xml version="1.0" encoding="utf-8"?>
<!--
    SCR-SV-02 một dòng kết quả (CMP-16 ListRow, theo demo-ui-android). Dòng 1: tên loại · hãng (type.card) và chevron_right.
    Dòng 2: "Phòng · Cơ sở" (type.caption, chữ phụ) và bên phải "Còn: n" (type.label) hoặc nhãn Hết hàng khi số lượng 0.
    Chữ dài xuống dòng, không cắt (UI-Screens 3.9). D09-L: dòng bấm được, mở SCR-SV-03 (chevron là dấu hiệu bấm được).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Ds.ListRow"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/ds_color_overlay_pressed"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ds_space_list_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_ten_loai"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Ds.TitleCard" />

            <ImageView
                android:id="@+id/img_chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_2"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/ds_icon_tint_secondary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_2"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_phong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.Ds.Caption"
                android:textColor="@color/ds_color_text_secondary" />

            <TextView
                android:id="@+id/tv_kha_dung"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_2"
                android:textAppearance="@style/TextAppearance.Ds.Label" />

            <com.nhom13.quanlymuontra.common.widget.StatusBadgeView
                android:id="@+id/sb_het_hang"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_2"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
